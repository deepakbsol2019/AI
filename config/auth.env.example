# Reference only: Spring Boot does NOT automatically load this .env-style file.
# Supply values through the process environment or your secret manager.
# Blank secrets are intentional; never commit a populated copy.

DB_URL=jdbc:mysql://localhost:3306/search_book_download?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=YOUR_APPLICATION_DATABASE_USER
DB_PASSWORD=

# Base64 encoding of >=32 cryptographically random bytes, generated for this deployment.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=book-search-download
AUTH_JWT_AUDIENCE=book-search-ui
AUTH_PUBLIC_BASE_URL=https://books.example.invalid
AUTH_TRUSTED_ORIGINS=https://books.example.invalid
TENANT_STORAGE_ROOT=C:/workspace/backend/Book_Search/upload-pdf

# Keep true for HTTPS production; explicit HTTP localhost development may use false.
AUTH_COOKIE_SECURE=true

# All integrations start disabled; disabled Google/SSO need no client secrets.
AUTH_MAIL_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_SSO_ENABLED=false

# Configure a real SMTP sender before enabling mail. These examples send nothing.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_TTL=PT15M

# Used by the optional external application-oidc.properties example.
# *_SECRET values are secrets; secret-ref configuration stores only these key names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://books.example.invalid/login/oauth2/code/google
COMPANY_OIDC_ISSUER_URI=https://id.example.invalid/realms/company
COMPANY_OIDC_CLIENT_ID=
COMPANY_OIDC_CLIENT_SECRET=
# Replace org-123 in both the external provider key and callback with the real provider code.
COMPANY_OIDC_REDIRECT_URI=https://books.example.invalid/login/oauth2/code/org-123
